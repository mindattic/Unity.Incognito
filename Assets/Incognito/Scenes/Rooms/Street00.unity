  m_Script: {fileID: 11500000, guid: 11103e1806807fc48a6af332c39a0139, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Incognito.Runtime::Incognito.World.Room
  displayName: Bleecher Street
  roomWidth: 11520
  playerWidth: 512
  player: {fileID: 468081258}
  music: {fileID: 8300000, guid: d7919ee143377d24ab00ad1f7e3ba3ec, type: 3}
  musicVolume: 1
  openingText: 'In a strange city lying alone

    Far down within the dim West,

    Where
    the good and the bad and the worst and the best

    Have gone to their eternal
    rest.

    There shrines and palaces and towers

    (Time-eaten towers that
    tremble not!)

    Resemble nothing that is ours.

    Around, by lifting winds
    forgot,

    Resignedly beneath the sky

    The melancholy waters lie.'
  openingTextPosition: {x: 10870, y: 100}
  descriptionBorder: {fileID: 2800000, guid: 7583964b71b0d384c81889b7fdafbee2, type: 3}
  viewCamera: {fileID: 1745245311}
