<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs Incognito.Core's rules outside Unity (dotnet test). Core is compiled in from its asmdef
       folder, so there is one source of truth and nothing here can reach UnityEngine. C# 9 matches
       what Unity builds, so nothing newer sneaks into Core. Core's Incognito.Core.asmdef references
       Unity.Shared.Core (U.INC-T25) for the dependency-free JSON reader/writer the settings
       registry and content catalog parse with, so its Json sources are compiled in the same way,
       from the sibling Unity.Shared checkout (../../../Unity.Shared from here, matching the
       "../../Unity.Shared" Packages/manifest.json uses from Packages one level up), resolving
       either to Unity.Shared next to this repo, or, from a worktree, to the Unity.Shared symlink
       MindAttic's worktree tooling keeps beside every repo's own worktrees. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Incognito.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Incognito/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../../Unity.Shared/unity/com.mindattic.unity.shared/Runtime/Core/Json/**/*.cs" Link="SharedJson/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
